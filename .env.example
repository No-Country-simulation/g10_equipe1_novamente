# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

SECRET_KEY=changethis

# Gemini
# A chave é opcional. Sem ela, o backend sobe e a geração falha com uma mensagem clara.
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
# Limites do plano gratuito lidos em 19/11/2026.
# GEMINI_EMBEDDING_RPM=100
# GEMINI_EMBEDDING_TPM=30000
# GEMINI_GENERATION_RPM=15

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# OCI Object Storage
# OCI_BUCKET=novamente-docs
# OCI_NAMESPACE=
# "api_key" lê o arquivo de configuração da OCI. "instance_principal" usa a identidade da VM.
# OCI_AUTH=api_key
# OCI_CONFIG_FILE=~/.oci/config
# OCI_CONFIG_PROFILE=DEFAULT
